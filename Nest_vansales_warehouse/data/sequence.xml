<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ── Van Receipt Sequence ────────────────────────────────────────── -->
        <record id="seq_vansales_receipt" model="ir.sequence">
            <field name="name">Van Sales Receipt</field>
            <field name="code">vansales.receipt</field>
            <field name="prefix">VSR</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- ── Van Audit Sequence ──────────────────────────────────────────── -->
        <record id="seq_vansales_audit" model="ir.sequence">
            <field name="name">Van Sales Audit</field>
            <field name="code">vansales.audit</field>
            <field name="prefix">VSA</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
